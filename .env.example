# 复制此文件为 .env.local，填入你的 Supabase 项目信息（.env.local 已被 git 忽略）
# 位置：Supabase 控制台 → Project Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Enable only after the coach history migration has been verified in this environment.
VITE_COACH_HISTORY_ENABLED=false

# AI（后端用，不带 VITE_ 前缀）。用哪个在 api/lib/ai.ts 顶部 MODEL 切换，填对应 key：
# Google Gemini（默认，有免费额度）: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=...
# OpenAI（可选）: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Anthropic（可选）: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 仅本地跑营养库 seed 脚本时需要（服务端密钥，sb_secret_ 开头，切勿放前端/提交）
# 位置：Supabase → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Staging / Vercel Preview（完整步骤见 docs/STAGING.md）──────────────
# Preview 环境：上面的 Supabase 变量全部填 staging 项目，并额外设置下面两项；
# 构建会拒绝未标记 staging 或指向生产项目的 Preview。
# VITE_APP_ENV=staging
# PRODUCTION_SUPABASE_PROJECT_REF=<生产项目 ref>
#
# 仅在终端里运行 npm run staging:seed 时临时设置，不要写进 .env.local 与生产变量混放：
# STAGING_SUPABASE_URL=https://<staging-ref>.supabase.co
# STAGING_SUPABASE_PROJECT_REF=<staging-ref>
# STAGING_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# STAGING_TEST_PASSWORD=<至少 12 位>
# 重建 foods 营养库时需要显式确认目标：SEED_SUPABASE_PROJECT_REF=<项目 ref>
