{
  "name": "bodybuddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b && node scripts/check-api-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "node --test --test-concurrency=1 scripts/db/database.test.mjs scripts/db/limits.test.mjs scripts/db/photos.test.mjs",
    "db:upgrade": "node scripts/db/upgrade.mjs",
    "db:types": "node scripts/db/types.mjs",
    "db:types:check": "node scripts/db/types.mjs --check",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@anthropic-ai/sdk": "^0.120.0",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.77",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "pg": "^8.23.0",
    "supabase": "2.116.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
